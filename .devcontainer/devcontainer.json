{
  "name": "Flutter",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "overrideCommand": true,
  "postCreateCommand": "sudo add-apt-repository universe -y && sudo apt-get update && sudo apt-get install -y scrcpy && flutter pub get",
  "containerEnv": {
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    "ANDROID_ADB_SERVER_ADDRESS": "host.docker.internal"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/nordcominc/devcontainer-features/android-sdk:2": {
      "disable_openjdk_installation": true
    },
    "ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {
      "version": "latest",
      "jdkVersion": "latest",
      "jdkDistro": "ms"
    }
  },
  "runArgs": [
    "--network=host",
    "--privileged",
    "--add-host=host.docker.internal:host-gateway",
    "-v", "/dev/bus/usb:/dev/bus/usb"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "remote.containers.enableWSLg": false,
        "remote.containers.mountWslDistro": false,
        "scrcpy.path": "/usr/bin",
        "scrcpy.adbPath": "/opt/android-sdk-linux/platform-tools"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-russian",
        "PKief.material-icon-theme",
        "alexisvt.flutter-snippets",
        "felixangelov.bloc",
        "nash.awesome-flutter-snippets",
        "pflannery.vscode-versionlens",
        "GitHub.vscode-github-actions",
        "izantech.scrcpy-vscode"
      ]
    }
  }
}
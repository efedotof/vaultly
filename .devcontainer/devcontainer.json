{
  "name": "Flutter",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "overrideCommand": true,
  "postCreateCommand": "yes | /opt/android-sdk-linux/cmdline-tools/latest/bin/sdkmanager --licenses && ln -sfn /opt/android-sdk-linux/platforms/android-37.0 /opt/android-sdk-linux/platforms/android-37 || true && sudo apt-get update && sudo apt-get install -y scrcpy ninja-build cmake socat && flutter pub get",
  "postStartCommand": "nohup socat tcp-listen:10388,bind=127.0.0.1,fork tcp:host.docker.internal:10388 > /tmp/socat.log 2>&1 &",
  "containerEnv": {
    "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037",
    "ANDROID_HOME": "/opt/android-sdk-linux",
    "ANDROID_SDK_ROOT": "/opt/android-sdk-linux"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {
      "version": "latest",
      "jdkVersion": "latest",
      "jdkDistro": "ms"
    }
  },
  "runArgs": [
    "--network=host",
    "--add-host=host.docker.internal:host-gateway"
  ],
  "forwardPorts": [
    10388
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "remote.containers.enableWSLg": false,
        "remote.containers.mountWslDistro": false,
        "scrcpy.path": "/usr/bin",
        "scrcpy.adbPath": "/opt/android-sdk-linux/platform-tools"
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-russian",
        "PKief.material-icon-theme",
        "alexisvt.flutter-snippets",
        "felixangelov.bloc",
        "nash.awesome-flutter-snippets",
        "pflannery.vscode-versionlens",
        "GitHub.vscode-github-actions",
        "izantech.scrcpy-vscode"
      ]
    }
  }
}
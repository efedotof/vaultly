{
  "name": "Flutter",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "overrideCommand": true,
  "postCreateCommand": "flutter pub get",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/nordcominc/devcontainer-features/android-sdk:2": {
      "disable_openjdk_installation": true
    },
    "ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {
      "version": "latest",
      "jdkVersion": "latest",
      "jdkDistro": "ms"
    }
  },
  "runArgs": [
    "--network=host"
  ],
  "forwardPorts": [
    8080,
    5037,
    5555
  ]
}